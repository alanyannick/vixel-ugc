# Production access gate: at least 16 UTF-8 bytes for the code and 32 for the
# HMAC secret. /studio and server APIs require the signed HttpOnly cookie.
STUDIO_ACCESS_CODE=
STUDIO_SESSION_SECRET=

# Public product origins and browser-safe provider configuration.
NEXT_PUBLIC_SITE_URL=https://ugc.vixelai.com
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# Server-only Supabase key. Use the new secret key format; never expose it
# through NEXT_PUBLIC_* variables.
SUPABASE_SECRET_KEY=

# Account launch readiness switches. Each feature also verifies all of its
# required credentials at runtime and fails closed when configuration is
# incomplete.
ENABLE_PUBLIC_WAITLIST=false
ENABLE_ACCOUNT_AUTH=false
ENABLE_CLOUD_CAMPAIGNS=false
ENABLE_LIFECYCLE_EMAIL=false
ENABLE_BILLING=false

# Immutable Supabase user IDs allowed to bootstrap the admin surface.
# Prefer the database-owned app_role after initial setup.
ADMIN_USER_IDS=

# Application-owned transactional email. OTP email is configured separately in
# Supabase custom SMTP and does not use this key at application runtime.
RESEND_API_KEY=
RESEND_TRANSACTIONAL_FROM=
RESEND_REPLY_TO=
RESEND_WEBHOOK_SECRET=
RESEND_PRODUCT_UPDATES_SEGMENT_ID=
RESEND_PRODUCT_UPDATES_TOPIC_ID=

# Stripe recurring billing. The price ID is configured only after the beta
# offer is confirmed.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_UGC_BETA=

# Vercel Cron bearer secret for bounded email delivery/reminder processing.
CRON_SECRET=

# NewAPI, server-only. Production rejects plaintext HTTP.
NEWAPI_BASE_URL=
NEWAPI_API_KEY=
NEWAPI_TEXT_MODEL=gpt-5.4-mini
NEWAPI_IMAGE_MODEL=gpt-image-2
NEWAPI_VIDEO_MODEL=veo-3.1-fast-generate-preview

# Paid generation is fail-closed unless explicitly enabled and every access,
# HTTPS provider, approval, and database check is ready.
ENABLE_LIVE_GENERATION=false

# Database-atomic UTC-day ceilings for newly claimed paid submissions. Existing
# idempotency replays remain readable after either ceiling is reached. Values
# must be positive integers within the documented operational bounds; invalid
# or excessive values fail safely to the conservative application defaults.
PAID_SUBMISSION_DAILY_IDENTITY_LIMIT=4
PAID_SUBMISSION_DAILY_GLOBAL_LIMIT=20

# Isolated PostgreSQL ledger required for live paid generation and recovery.
# DATABASE_APP_URL is preferred for the runtime. Its login role must inherit
# vixel_koc_runtime and vixel_ugc_runtime without superuser, BYPASSRLS,
# schema-CREATE, or unneeded DELETE privileges; never reuse another product's
# database/schema without an explicit migration and isolation decision.
DATABASE_URL=
DATABASE_APP_URL=
DATABASE_MIGRATION_URL=
