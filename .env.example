# Public canonical URL. Use the deployed origin in production.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Optional access gate. If set, /studio asks for this code and server APIs
# require the signed HttpOnly session cookie.
STUDIO_ACCESS_CODE=
STUDIO_SESSION_SECRET=

# NewAPI, server-only.
NEWAPI_BASE_URL=
NEWAPI_API_KEY=
NEWAPI_TEXT_MODEL=gemini-2.5-flash
NEWAPI_IMAGE_MODEL=gpt-image-2
NEWAPI_VIDEO_MODEL=seedance-2.0

# Paid generation is fail-closed unless explicitly enabled.
ENABLE_LIVE_GENERATION=false

# Optional namespaced Postgres persistence.
DATABASE_URL=
DATABASE_APP_URL=
DATABASE_MIGRATION_URL=
