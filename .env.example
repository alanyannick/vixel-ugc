# Public canonical URL. Use the deployed origin in production.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Production access gate: at least 16 UTF-8 bytes for the code and 32 for the
# HMAC secret. /studio and server APIs require the signed HttpOnly cookie.
STUDIO_ACCESS_CODE=
STUDIO_SESSION_SECRET=

# NewAPI, server-only. Production rejects plaintext HTTP.
NEWAPI_BASE_URL=
NEWAPI_API_KEY=
NEWAPI_TEXT_MODEL=gemini-2.5-flash
NEWAPI_IMAGE_MODEL=gpt-image-2
NEWAPI_VIDEO_MODEL=seedance-2.0

# Paid generation is fail-closed unless explicitly enabled and every access,
# HTTPS provider, approval, and database check is ready.
ENABLE_LIVE_GENERATION=false

# Isolated PostgreSQL ledger required for live paid generation and recovery.
# DATABASE_APP_URL is preferred for the runtime; never reuse another product's
# schema without an explicit isolation decision.
DATABASE_URL=
DATABASE_APP_URL=
DATABASE_MIGRATION_URL=
