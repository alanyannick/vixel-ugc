{
  "name": "vixel-ugc-studio",
  "version": "0.1.0",
  "private": true,
  "description": "A source-grounded AI UGC campaign studio powered by a durable creative router.",
  "engines": {
    "node": "22.x"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:postgres-ledger": "VIXEL_POSTGRES_INTEGRATION=1 vitest run tests/integration/postgres-ledger.integration.test.ts",
    "test:postgres-ledger:prepare": "node scripts/prepare-postgres-ledger-integration.mjs",
    "test:e2e": "playwright test",
    "posttest:e2e": "next typegen",
    "check": "npm run lint && npm run typecheck && npm run test && npm run build"
  },
  "dependencies": {
    "@ai-sdk/openai-compatible": "3.0.17",
    "@fontsource-variable/manrope": "5.3.0",
    "@fontsource-variable/syne": "5.3.0",
    "@supabase/supabase-js": "2.111.0",
    "ai": "7.0.42",
    "clsx": "2.1.1",
    "idb-keyval": "6.3.0",
    "lucide-react": "1.27.0",
    "motion": "12.43.0",
    "next": "16.2.12",
    "pg": "8.22.0",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "resend": "6.18.1",
    "sharp": "0.35.3",
    "stripe": "22.4.0",
    "svix": "1.99.1",
    "tailwind-merge": "3.5.0",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@playwright/test": "1.62.0",
    "@tailwindcss/postcss": "4.3.3",
    "@testing-library/jest-dom": "7.0.0",
    "@testing-library/react": "16.3.2",
    "@types/node": "26.1.2",
    "@types/pg": "8.20.0",
    "@types/react": "19.2.17",
    "@types/react-dom": "19.2.3",
    "eslint": "9.39.5",
    "eslint-config-next": "16.2.12",
    "jsdom": "27.4.0",
    "postcss": "8.5.25",
    "tailwindcss": "4.3.3",
    "typescript": "5.9.3",
    "vitest": "4.1.10"
  },
  "overrides": {
    "postcss": "8.5.25",
    "sharp": "0.35.3"
  }
}
